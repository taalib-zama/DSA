A = (1,2,3,4)


n is always even


0,1,




1,2,3,4,5,6
K = 3
(1,2) - 3 % 3 = 0
(1,4) - 5 % 3 = 2
(1,6) - 7 % 3 = 1
(3,2) - 5 % 3 = 2
(3,4) - 7 % 3 = 1
(3,6) - 9 % 3 = 0
(5,2) - 7 % 3 = 1
(5,4) - 9 % 3 = 0
(5,6) - 11 % 3 = 2

max = 2

even 1,3,5
odd = 2,4,6,7

function find_maximum_remainder(N, A, k) {
    let odd = [];
    let even = [];

    // Separate odd and even numbers
    for (let num of A) {
        if (num % 2 === 0) {
            even.push(num);
        } else {
            odd.push(num);
        }
    }

    let maxRemainder = 0;

    // Calculate maximum remainder from sums of odd and even pairs
    for (let o of odd) {
        for (let e of even) {
            let sum = o + e;
            let remainder = sum % k;
            if (remainder > maxRemainder) {
                maxRemainder = remainder;
            }
        }
    }

    return maxRemainder;
}